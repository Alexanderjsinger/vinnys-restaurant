# Local development only. Do not use this password on a public server.
ADMIN_PASSWORD=local-dev-only-change-me

# Set to true when the site is served over HTTPS.
# Leave false for http://localhost so the admin cookie is stored.
COOKIE_SECURE=false

# Optional. Leave blank locally unless testing Resend against a verified sender.
# Never commit real values. On Cloudflare, set these as Worker secrets.
# RESEND_API_KEY=
# RESEND_FROM=
